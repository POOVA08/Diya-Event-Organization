}

/* ===== PAGE BACKGROUND ===== */
.page {
    min-height: 100vh;
    background: url("../Media/Home/H2.png") no-repeat center/cover;
    padding: 30px;
    text-align: center;
}

/* TITLE */
.page h1 {
    color: white;
    font-size: 40px;
    margin-bottom: 30px;
    text-shadow: 2px 2px 5px black;
}

/* SECTION BOX */
.section {
    margin: 40px auto;
    padding: 20px;
    max-width: 1000px;
    background: rgba(0,0,0,0.6);
    border-radius: 12px;
}

/* SECTION HEADINGS */
.section h2 {
    color: white;
    font-size: 28px;
    margin-bottom: 10px;
}

.section p {
    color: white;
    margin-bottom: 15px;
}

/* IMAGE GALLERY */
.gallery {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
}

/* IMAGES */
.gallery img {
    width: 250px;
    height: 250px;
    object-fit: cover;
    object-position: center;
    border-radius: 10px;
    transition: 0.3s;
}

.gallery img:hover {
    transform: scale(1.05);
}

/* VIDEO */
video {
    width: 300px;
    margin: 10px;
    border-radius: 10px;
}

/* RESPONSIVE */
@media (max-width: 768px) {
    .gallery img {
        width: 150px;
        height: 120px;
    }

    video {
        width: 90%;
    }
}

