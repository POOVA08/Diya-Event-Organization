/* RESET */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}



/* BODY */
body {
    font-family: Arial, sans-serif;
    overflow-x: hidden;
}

/* =======================
   FUNCTIONS PAGE CARD
======================= */
.bg-center {
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: url("../Media/Home/H2.png") no-repeat center/cover;
}

.card {
    width: 320px;
    background: rgba(0,0,0,0.6);
    color: white;
    padding: 30px;
    border-radius: 12px;
    text-align: center;
    transition: 0.3s;
}

.card:hover {
    transform: translate(-50%, -50%)
    scale(1);
}

.card ul {
    list-style: none;
    margin-top: 15px;
}

.card li {
    margin: 10px 0;
}

.card a {
    text-decoration: none;
    color: white;
    font-size: 18px;
}

.card a:hover {
    color: yellow;
}

/* =======================
   EVENT CARDS GRID
======================= */
.container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 25px;
    padding: 40px;
}

/* EVENT CARD */
.event-card {
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 8px 20px rgba(0,0,0,0.5);
    transition: 0.3s;
    background: white;
}

.event-card:hover {
    transform: scale(1.05);
}

.event-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.event-content {
    padding: 15px;
    text-align: center;
}

.event-content h3 {
    margin-bottom: 10px;
}

/* =======================
   SERVICES GALLERY
======================= */
.gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    padding: 20px;
    justify-content: center;
}

.gallery img {
    width: 300px;
    height: 200px;
    object-fit: cover;
    border-radius: 10px;
    transition: 0.3s;
}

.gallery img:hover {
    transform: scale(1.05);
}

/* =======================
   TABLE STYLE (if used)
======================= */
table, th, td {
    border: 2px solid black;
    border-collapse: collapse;
    padding: 10px;
    text-align: center;
}


/* NEW NAVBAR CSS START */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 30px;
    background: black;
}

.logo {
    color: deeppink;
    font-size: 20px;
}

.menu a {
    color: white;
    text-decoration: none;
